{
  "name": "health-city",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs vite",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit && tsc --project tsconfig.frontend.json --noEmit && tsc --project tsconfig.tools.json --noEmit",
    "test": "vitest run --exclude '**/*.runtime.test.ts'",
    "test:runtime": "vitest run src/worker/*.runtime.test.ts",
    "build": "NODE_ENV=production WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs vite build",
    "deploy": "npm run build && WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --config dist/healthcity/wrangler.json --keep-vars",
    "asset:boat": "node scripts/build-boat.mjs",
    "asset:port": "node scripts/build-cargo-berth.mjs",
    "asset:building": "node scripts/build-building.mjs",
    "asset:skyscrapers": "node scripts/build-skyscrapers.mjs",
    "asset:pedestrian": "node scripts/build-pedestrian.mjs",
    "asset:vehicles": "node scripts/build-vehicles.mjs",
    "test:browser": "playwright test",
    "secret:google": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler secret put GOOGLE_CLIENT_SECRET"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.68.0",
    "@cloudflare/workers-types": "5.20261109.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/three": "0.181.0",
    "@vitejs/plugin-react": "5.1.4",
    "esbuild": "0.28.2",
    "miniflare": "5.20261109.0-beta",
    "typescript": "7.0.2",
    "vite": "7.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.159.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@react-three/fiber": "9.4.0",
    "jose": "6.2.17",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.181.2"
  }
}
