{
  "name": "health-city",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --local --ip 127.0.0.1 --port 8787",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "vitest run --exclude '**/*.runtime.test.ts'",
    "test:runtime": "vitest run src/worker/*.runtime.test.ts",
    "build": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --keep-vars",
    "secret:google": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler secret put GOOGLE_CLIENT_SECRET"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261109.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20261109.0-beta",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.159.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "jose": "6.2.17"
  }
}
